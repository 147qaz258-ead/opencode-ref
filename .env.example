# 应用配置
NODE_ENV=production
OPENCODE_MODE=production

# 存储配置
MONGODB_URI=mongodb://mongodb:27017/opencode?retryWrites=true&w=majority
REDIS_URL=redis://redis:6379

# 沙箱配置
SANDBOX_BACKEND=docker                    # 沙箱后端选择: docker (本地), e2b (云端)
OPENCODE_BACKEND=http-api
OPENCODE_SANDBOX_IMAGE=opencode-sandbox-playwright:latest
OPENCODE_CONTAINER_IDLE_TIMEOUT=1800000  # 30 minutes

# E2B 沙箱配置 (当 SANDBOX_BACKEND=e2b 时需要)
E2B_API_KEY=your_e2b_api_key_here                           # 从 https://e2b.dev 获取 API Key
# E2B_TEMPLATE_ID=                       # 自定义 E2B 模板 ID (可选)
# E2B_TIMEOUT=120000                     # 命令执行超时时间 (毫秒)，默认 120 秒

# LLM 提供商配置
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# 日志配置
LOG_LEVEL=info

# Media Generation Configuration
# IMAGE_PROVIDER=zhipu                    # 图片生成提供商 (zhipu, modelscope, hunyuan, huggingface)
# IMAGE_API_KEY=your_api_key_here         # API 密钥
# IMAGE_MODEL=cogview-3-plus              # 模型 (可选，留空使用 provider 默认值)
# IMAGE_API_BASE=                         # API 基础 URL (可选，自动根据 provider 选择)

# Provider-specific API bases (optional, override defaults)
# Zhipu AI: https://open.bigmodel.cn
#   API Key: Your API key from https://open.bigmodel.cn
#   图片模型: cogview-3, cogview-3-plus, cogview-3-flash
#   默认: cogview-3
#

  ModelScope (魔搭社区): https://api-inference.modelscope.cn
  API Key: your_modelscope_api_key_here
  Free tier: 2000 calls/day
  图片模型: Qwen/Qwen-Image-2512
  默认: Qwen/Qwen-Image-2512

#
# Tencent Hunyuan (腾讯混元): https://hunyuan.tencentcloudapi.com
#   API Key: Format "secretId:secretKey" from Tencent Cloud
#   Example: AKIDxxxxxx:xxxxxx
#   Get credentials: https://console.cloud.tencent.com/cam/capi
#   图片模型: hunyuan-image
#   默认: hunyuan-image
#
# Hugging Face: https://api-inference.huggingface.co
#   API Key: your_huggingface_api_key_here
#   Supports thousands of open-source models
#   图片模型: stabilityai/stable-diffusion-3-medium, flux-schnell, etc.
#   默认: stabilityai/stable-diffusion-3-medium

# VIDEO_PROVIDER=zhipu                    # 视频生成提供商 (zhipu, hunyuan, tongyi, siliconcloud, huggingface)
# VIDEO_API_KEY=your_api_key_here         # API 密钥
# VIDEO_MODEL=cogvideox                   # 模型 (可选，留空使用 provider 默认值)
# VIDEO_API_BASE=                         # API 基础 URL (可选)

# Video Provider API bases
# Zhipu AI: https://open.bigmodel.cn
#   视频模型: cogvideox
#   默认: cogvideox
#
# Tencent Hunyuan (腾讯混元): https://hunyuan.tencentcloudapi.com
#   API Key: Format "secretId:secretKey"
#   视频模型: hunyuan-video
#   默认: hunyuan-video
#
# Alibaba Tongyi (通义万象): https://dashscope.aliyuncs.com
#   API Key: Your API key from https://dashscope.aliyuncs.com
#   视频模型: wanx-v2
#   默认: wanx-v2
#
# SiliconCloud LTX-Video: https://api.siliconflow.cn
#   API Key: Your API key from https://cloud.siliconflow.cn
#   Ultra-fast: 4s video in ~4s
#   视频模型: Lightricks/LTX-Video
#   默认: Lightricks/LTX-Video
#
  Hugging Face: https://api-inference.huggingface.co
  API Key: your_huggingface_api_key_here
  视频模型: Wan-AI/Wan2.1
  默认: Lightricks/LTX-Video
